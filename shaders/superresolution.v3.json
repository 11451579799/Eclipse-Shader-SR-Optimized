{
  "schema_version": 3,
  "profiles": {
    "*": {
      "jitter": {
        "enabled": true,
        "source": "mod"
      },
      "upscale": {
        "enabled": true,
        "internal_format": "rgba16f",
        "hdr": true,
        "auto_exposure": true,
        "motion_jittered": false,
        "disabled_algorithms": ["fsr1", "fsr2", "sgsr1", "sgsr2", "anime4k", "dlssrr"],
        "trigger": {
          "type": "BEFORE",
          "pass": "composite7"
        },
        "inputs": {
          "color": {
            "enabled": true,
            "src": "autotex3",
            "region": [0, 0, -1, -1]
          },
          "depth": {
            "enabled": true,
            "src": "depthtex",
            "region": [0, 0, -1, -1]
          },
          "motion_vectors": {
            "enabled": true,
            "src": "autotex0",
            "region": [0, 0, -1, -1]
          }
        },
        "outputs": {
          "upscaled_color": {
            "enabled": true,
            "target": ["colortex5"],
            "region": [0, 0, -2, -2]
          }
        }
      }
    }
  }
}
